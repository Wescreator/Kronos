{
  "name": "kronos-backend",
  "version": "1.0.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/database/migrate.js",
    "seed": "node src/database/seeds/001_seed_initial_data.js",
    "seed:dev": "node src/database/seeds/003_seed_developer.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:pull": "prisma db pull",
    "prisma:studio": "prisma studio",
    "dev:local": "cross-env NODE_ENV=development node -r dotenv/config src/server.js dotenv_config_path=.env.development",
    "seed:local": "node src/database/seeds/004_seed_local_users.js",
    "test": "node --test"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "date-fns": "^3.0.0",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "googleapis": "^173.0.0",
    "helmet": "^7.0.0",
    "joi": "^17.13.4",
    "jsonwebtoken": "^9.0.0",
    "multer": "^2.2.0",
    "node-cron": "^4.5.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.11.0",
    "resend": "^4.6.0",
    "uuid": "^14.0.1",
    "ws": "^8.0.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "nodemon": "^3.0.0",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2"
  }
}
