# Copie este arquivo para .env e preencha com SEUS próprios valores.
# NUNCA versione o .env real nem reutilize estes placeholders em produção.
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │ PRODUÇÃO (Render): estas variáveis devem ser definidas no dashboard de   │
# │ Environment do serviço, NÃO neste arquivo. Em produção, garanta:         │
# │   NODE_ENV=production            (oculta detalhes de erro 5xx ao cliente, │
# │                                   ativa aviso de TLS do banco)           │
# │   DB_SSL_REJECT_UNAUTHORIZED=true + DB_SSL_CA=<CA do Supabase>            │
# │     → SOMENTE na conexão DIRETA (db.<projeto>.supabase.co). O POOLER      │
# │       (...pooler.supabase.com) usa certificado self-signed: com          │
# │       reject=true SEM a CA correta a conexão QUEBRA. Se usar o pooler,    │
# │       mantenha reject=false (a conexão continua criptografada).           │
# └─────────────────────────────────────────────────────────────────────────┘

PORT=3001
NODE_ENV=development

# Conexão PostgreSQL (ex.: Supabase)
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO
DB_HOST=db.SEU_PROJETO.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=SUA_SENHA_AQUI

# Validação do certificado TLS do banco. Ver caveat do pooler acima.
# Só tem efeito quando SSL está ativo (NODE_ENV != development).
DB_SSL_REJECT_UNAUTHORIZED=true
# CA em PEM (multilinha ou uma linha com \n escapado). Necessária para
# DB_SSL_REJECT_UNAUTHORIZED=true na conexão direta do Supabase.
DB_SSL_CA=
# Mata no servidor qualquer query que passe deste tempo (ms). Default 15000.
DB_STATEMENT_TIMEOUT_MS=15000

# Gere cada segredo com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GERE_UM_SEGREDO_FORTE
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=GERE_OUTRO_SEGREDO_FORTE
JWT_REFRESH_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:5173
UPLOAD_MAX_SIZE=10485760

# ── Rate limiting da API (Token Bucket em memória, por IP) ──
# Rede de proteção ampla contra exaustão da API. Valores folgados: só
# barram abuso/loop, não o uso normal. Rajada (capacity) e taxa sustentada.
API_RATE_CAPACITY=120
API_RATE_REFILL_PER_SEC=10

# ── Timeouts do servidor HTTP (anti slowloris) ──
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=20000

# ── Limites do WebSocket (anti flood / exaustão de memória) ──
WS_MAX_CONN_PER_USER=10
WS_MSG_MAX_PER_WINDOW=30
WS_MSG_WINDOW_MS=10000

# Google Drive (service account) — anexos de propostas
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Envio de e-mail
GMAIL_USER=
