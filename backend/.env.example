# Copie este arquivo para .env e preencha com SEUS próprios valores.
# NUNCA versione o .env real nem reutilize estes placeholders em produção.

PORT=3001
NODE_ENV=development

# Conexão PostgreSQL (ex.: Supabase)
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO
DB_HOST=db.SEU_PROJETO.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=SUA_SENHA_AQUI

# Valide o certificado TLS do banco. Use "false" apenas se o provedor
# exigir (não recomendado em produção).
DB_SSL_REJECT_UNAUTHORIZED=true

# Gere cada segredo com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GERE_UM_SEGREDO_FORTE
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=GERE_OUTRO_SEGREDO_FORTE
JWT_REFRESH_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:5173
UPLOAD_MAX_SIZE=10485760

# Google Drive (service account) — anexos de propostas
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Envio de e-mail
GMAIL_USER=
